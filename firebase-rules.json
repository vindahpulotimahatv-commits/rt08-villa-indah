{
  "rules": {
    "daftarHadir": {
      ".read": true,
      "$rumahKey": {
        ".write": "!data.exists() || (auth != null && newData.child('nama').val() === data.child('nama').val() && newData.child('rumah').val() === data.child('rumah').val())",
        ".validate": "newData.hasChildren(['nama','rumah','waktu','status']) && newData.child('nama').isString() && newData.child('rumah').isString() && newData.child('status').isString()"
      }
    },
    "agenda": {
      ".read": true,
      ".write": "auth != null && auth.uid == 'DOHOhpaimmTY2oB1WxbNQg0BLIG2'"
    },
    "informasi": {
      ".read": true,
      ".write": "auth != null && (auth.uid == 'DOHOhpaimmTY2oB1WxbNQg0BLIG2' || auth.uid == '1VnzbcWA8edwPLFNfASNnUK9bn22')"
    },
    "galeri": {
      ".read": true,
      ".write": "auth != null && auth.uid == 'DOHOhpaimmTY2oB1WxbNQg0BLIG2'"
    },
    "umkm": {
      ".read": true,
      ".write": "auth != null && auth.uid == 'DOHOhpaimmTY2oB1WxbNQg0BLIG2'"
    },
    "umkmPengajuan": {
      ".read": "auth != null && auth.uid == 'DOHOhpaimmTY2oB1WxbNQg0BLIG2'",
      ".write": true
    },
    "laporan": {
      ".read": "auth != null && auth.uid == 'DOHOhpaimmTY2oB1WxbNQg0BLIG2'",
      ".write": true
    },
    "obrolan": {
      ".read": true,
      ".write": true
    },
    "wargaKontak": {
      ".read": "auth != null && (auth.uid == 'DOHOhpaimmTY2oB1WxbNQg0BLIG2' || auth.uid == '1VnzbcWA8edwPLFNfASNnUK9bn22')",
      ".write": "auth != null && (auth.uid == 'DOHOhpaimmTY2oB1WxbNQg0BLIG2' || auth.uid == '1VnzbcWA8edwPLFNfASNnUK9bn22')"
    },
    "penarikan": {
      ".read": "auth != null && (auth.uid == 'DOHOhpaimmTY2oB1WxbNQg0BLIG2' || auth.uid == '1VnzbcWA8edwPLFNfASNnUK9bn22')",
      "$bulan": {
        "$rumah": {
          ".write": "auth != null && (auth.uid == 'DOHOhpaimmTY2oB1WxbNQg0BLIG2' || (auth.uid == '1VnzbcWA8edwPLFNfASNnUK9bn22' && (!data.exists() || (data.child('status').val() != 'lunas_transfer' && data.child('disetorKonfirmasi').val() != true))))",
          ".validate": "newData.hasChildren(['rumah','jumlah','metode','status','petugas']) && newData.child('rumah').isString() && newData.child('jumlah').isNumber() && newData.child('jumlah').val() > 0 && newData.child('jumlah').val() <= 100000000 && (newData.child('metode').val() == 'cash' || newData.child('metode').val() == 'transfer' || newData.child('metode').val() == 'lainnya') && (newData.child('status').val() == 'lunas_cash' || newData.child('status').val() == 'transfer_pending' || newData.child('status').val() == 'lunas_transfer' || newData.child('status').val() == 'belum') && newData.child('petugas').isString()"
        }
      }
    },
    "buktiTransfer": {
      ".read": "auth != null && (auth.uid == 'DOHOhpaimmTY2oB1WxbNQg0BLIG2' || auth.uid == '1VnzbcWA8edwPLFNfASNnUK9bn22')",
      "$bulan": {
        "$rumah": {
          ".write": "auth != null && (auth.uid == 'DOHOhpaimmTY2oB1WxbNQg0BLIG2' || auth.uid == '1VnzbcWA8edwPLFNfASNnUK9bn22')"
        }
      }
    },
    "humasSetoran": {
      ".read": "auth != null && (auth.uid == 'DOHOhpaimmTY2oB1WxbNQg0BLIG2' || auth.uid == '1VnzbcWA8edwPLFNfASNnUK9bn22')",
      "$id": {
        ".write": "auth != null && (( !data.exists() && (auth.uid == 'DOHOhpaimmTY2oB1WxbNQg0BLIG2' || auth.uid == '1VnzbcWA8edwPLFNfASNnUK9bn22')) || (!newData.exists() && data.child('status').val() == 'menunggu' && (auth.uid == 'DOHOhpaimmTY2oB1WxbNQg0BLIG2' || auth.uid == '1VnzbcWA8edwPLFNfASNnUK9bn22')) || (data.exists() && newData.exists() && data.child('status').val() == 'menunggu' && newData.child('status').val() == 'diterima' && auth.uid == 'DOHOhpaimmTY2oB1WxbNQg0BLIG2' && newData.child('jumlah').val() == data.child('jumlah').val() && newData.child('petugas').val() == data.child('petugas').val() && newData.child('bulanKey').val() == data.child('bulanKey').val()))",
        ".validate": "newData.hasChildren(['bulanKey','petugas','jumlah','rumahKeys','status']) && newData.child('jumlah').isNumber() && newData.child('jumlah').val() > 0 && (newData.child('status').val() == 'menunggu' || newData.child('status').val() == 'diterima')"
      }
    },
    "kritikSaran": {
      ".read": "auth != null && (auth.uid == 'DOHOhpaimmTY2oB1WxbNQg0BLIG2' || auth.uid == 'S1wZXXYJixTlw0VCQyvDf2eVXv23' || auth.uid == '1VnzbcWA8edwPLFNfASNnUK9bn22')",
      "$id": {
        ".write": "(!data.exists() && newData.exists()) || (auth != null && auth.uid == 'DOHOhpaimmTY2oB1WxbNQg0BLIG2' && !newData.exists())",
        ".validate": "newData.hasChildren(['kritik','saran','createdAt']) && (newData.child('kritik').val().length + newData.child('saran').val().length) > 0",
        "kritik": {
          ".validate": "newData.isString() && newData.val().length <= 1000"
        },
        "saran": {
          ".validate": "newData.isString() && newData.val().length <= 1000"
        },
        "createdAt": {
          ".validate": "newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "surveiApp": {
      ".read": "auth != null && (auth.uid == 'DOHOhpaimmTY2oB1WxbNQg0BLIG2' || auth.uid == 'S1wZXXYJixTlw0VCQyvDf2eVXv23' || auth.uid == '1VnzbcWA8edwPLFNfASNnUK9bn22')",
      "$id": {
        ".write": "(!data.exists() && newData.exists()) || (auth != null && auth.uid == 'DOHOhpaimmTY2oB1WxbNQg0BLIG2' && !newData.exists())",
        ".validate": "newData.hasChildren(['sumber','perangkat','bantu','fitur','khawatir','bersedia','bantuan','tampilan','tulisan','nps','versi','createdAt'])",
        "sumber": {
          ".validate": "newData.isString() && (newData.val() == 'wa' || newData.val() == 'papan' || newData.val() == 'tetangga' || newData.val() == 'pengurus')"
        },
        "perangkat": {
          ".validate": "newData.isString() && (newData.val() == 'android' || newData.val() == 'iphone' || newData.val() == 'keduanya' || newData.val() == 'belum')"
        },
        "bantu": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5 && newData.val() % 1 == 0"
        },
        "fitur": {
          "$f": {
            ".validate": "newData.isBoolean() && newData.val() == true && ($f == 'pengumuman' || $f == 'agenda' || $f == 'surat' || $f == 'lapor' || $f == 'iuran' || $f == 'kas' || $f == 'umkm' || $f == 'galeri' || $f == 'chat' || $f == 'info')"
          }
        },
        "khawatir": {
          ".validate": "newData.isString() && (newData.val() == 'teknologi' || newData.val() == 'privasi' || newData.val() == 'error' || newData.val() == 'wa' || newData.val() == 'tidak')"
        },
        "bersedia": {
          ".validate": "newData.isString() && (newData.val() == 'ya' || newData.val() == 'mungkin' || newData.val() == 'belum' || newData.val() == 'tidak')"
        },
        "bantuan": {
          ".validate": "newData.isString() && (newData.val() == 'panduan' || newData.val() == 'sosialisasi' || newData.val() == 'dibantu' || newData.val() == 'tidak')"
        },
        "tampilan": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5 && newData.val() % 1 == 0"
        },
        "tulisan": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5 && newData.val() % 1 == 0"
        },
        "kendala": {
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "saran": {
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "nps": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10 && newData.val() % 1 == 0"
        },
        "versi": {
          ".validate": "newData.isString() && newData.val().length <= 10"
        },
        "createdAt": {
          ".validate": "newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "appConfig": {
      ".read": "auth != null && auth.uid == 'DOHOhpaimmTY2oB1WxbNQg0BLIG2'",
      "testMode": {
        ".write": "auth != null && auth.uid == 'DOHOhpaimmTY2oB1WxbNQg0BLIG2'",
        ".validate": "newData.isBoolean()"
      }
    },
    "ringkasanKeuangan": {
      ".read": true,
      ".write": "auth != null && (auth.uid == 'DOHOhpaimmTY2oB1WxbNQg0BLIG2' || auth.uid == 'S1wZXXYJixTlw0VCQyvDf2eVXv23')"
    },
    "keuangan": {
      ".read": "auth != null && (auth.uid == 'DOHOhpaimmTY2oB1WxbNQg0BLIG2' || auth.uid == 'S1wZXXYJixTlw0VCQyvDf2eVXv23' || auth.uid == '1VnzbcWA8edwPLFNfASNnUK9bn22')",
      "$id": {
        ".write": "auth != null && auth.uid == 'DOHOhpaimmTY2oB1WxbNQg0BLIG2' && (!data.exists() || (data.exists() && root.child('appConfig/testMode').val() == true))",
        ".validate": "newData.hasChildren(['tanggal','jenis','keterangan','jumlah']) && newData.child('tanggal').isString() && newData.child('jenis').isString() && (newData.child('jenis').val() == 'masuk' || newData.child('jenis').val() == 'keluar') && newData.child('keterangan').isString() && newData.child('jumlah').isNumber() && newData.child('jumlah').val() > 0 && newData.child('jumlah').val() <= 1000000000"
      }
    }
  }
}
